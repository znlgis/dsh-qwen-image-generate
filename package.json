{
  "name": "@dsh-gis/dsh-qwen-image-generate",
  "version": "1.4.0",
  "license": "MIT",
  "description": "Generate images and videos with the Qwen Token Plan models (wan2.7-image-pro, wan3.0-video, ...) and save them into the session workspace.",
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "_offline-test.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node _offline-test.mjs",
    "check": "node --check index.js && node --check _offline-test.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "qwen",
    "image-generation",
    "video-generation",
    "wan"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/znlgis/dsh-qwen-image-generate.git"
  },
  "homepage": "https://github.com/znlgis/dsh-qwen-image-generate",
  "bugs": {
    "url": "https://github.com/znlgis/dsh-qwen-image-generate/issues"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "publishConfig": {
    "access": "public"
  }
}
